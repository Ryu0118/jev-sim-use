{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "./.codex/hooks/pre-commit-lint.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "./.codex/hooks/format.sh"
          },
          {
            "type": "command",
            "command": "./.codex/hooks/post-edit-lint.sh"
          },
          {
            "type": "command",
            "command": "./.codex/hooks/post-edit-ast-lint.sh"
          },
          {
            "type": "command",
            "command": "./.codex/hooks/gitnagg-check.sh"
          }
        ]
      }
    ]
  }
}
