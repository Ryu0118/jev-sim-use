#!/usr/bin/env python3
"""A stand-in Jev server for scripts/e2e.sh: answers each evaluation from a scripted list, in order.

Usage: stub-jev <scenario.json> <output-dir>. Binds 127.0.0.1 on a free port and writes it to <output-dir>/port.
Each request body is kept as <output-dir>/requests/<n>.json. An answer in the scenario's "answers" list is

    {"op": "tap", "p": 0.9, "also": {"done": 0.05}, "finishes": 0.1,
     "target": "<element label>", "tp": 0.95, "field": "<field label>", "text": "<text name>"}

or {"status": 422, "body": "..."} for an HTTP failure. Targets are named by label and resolved to the element id
the request's state gives that label. An operation or target the request did not offer, or a request beyond the
script, is answered with a 422 naming the problem (never a 5xx, which the client would retry with backoff), so the
run fails loudly instead of drifting.
"""

import json
import os
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer

SCENARIO, OUTPUT = sys.argv[1], sys.argv[2]
with open(SCENARIO) as file:
    ANSWERS = json.load(file).get("answers", [])
LOCK = threading.Lock()
COUNT = [0]


def choice(value, probabilities, offered, question):
    if value not in offered:
        raise ValueError(f"{question} {value!r} was not offered; options: {sorted(offered)}")
    return {"type": "choice", "choice": value, "probabilities": probabilities, "confidence": probabilities[value]}


def element_id(label, state, offered, question):
    ids = [element["id"] for element in state["screen"]["elements"] if element.get("label") == label]
    matches = [identifier for identifier in ids if identifier in offered]
    if not matches:
        raise ValueError(f"{question}: no offered element labelled {label!r}")
    return matches[0]


def respond(script, request):
    questions, state = request["questions"], request["state"]

    def offered(question):
        return set(questions.get(question, {}).get("criteria") or {})

    probabilities = {script["op"]: script["p"], **script.get("also", {})}
    answers = {"operation": choice(script["op"], probabilities, offered("operation"), "operation"),
               "finishes": {"type": "noul", "noul": script.get("finishes", 0.1)}}
    for key, question in (("target", "element_target"), ("field", "field_target")):
        if key in script:
            identifier = element_id(script[key], state, offered(question), question)
            answers[question] = choice(identifier, {identifier: script.get("tp", 0.95)}, offered(question), question)
    if "text" in script:
        answers["text_to_enter"] = choice(script["text"], {script["text"]: 1.0}, offered("text_to_enter"), "text")
    return {"model": request.get("model", "jev-e2e"), "answers": answers,
            "usage": {"input_tokens": 1000, "output_tokens": 10}}


class Handler(BaseHTTPRequestHandler):
    def do_POST(self):
        body = self.rfile.read(int(self.headers.get("Content-Length", 0)))
        with LOCK:
            COUNT[0] += 1
            number = COUNT[0]
        with open(os.path.join(OUTPUT, "requests", f"{number}.json"), "wb") as file:
            file.write(body)
        status, payload = 200, None
        try:
            if self.path != "/v1/systemone":
                raise ValueError(f"unexpected path {self.path}")
            if not self.headers.get("Authorization", "").startswith("Bearer "):
                raise ValueError("no bearer token")
            if number > len(ANSWERS):
                raise ValueError(f"request {number} has no scripted answer")
            script = ANSWERS[number - 1]
            if "status" in script:
                status, payload = script["status"], script.get("body", "scripted failure")
            else:
                payload = json.dumps(respond(script, json.loads(body)))
        except (ValueError, KeyError) as error:
            status, payload = 422, f"stub-jev: {error}"
            with open(os.path.join(OUTPUT, "stub-errors.txt"), "a") as file:
                file.write(f"request {number}: {error}\n")
        data = payload.encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)

    def log_message(self, *arguments):
        pass


os.makedirs(os.path.join(OUTPUT, "requests"), exist_ok=True)
server = ThreadingHTTPServer(("127.0.0.1", 0), Handler)
with open(os.path.join(OUTPUT, "port.tmp"), "w") as file:
    file.write(str(server.server_address[1]))
os.rename(os.path.join(OUTPUT, "port.tmp"), os.path.join(OUTPUT, "port"))
server.serve_forever()
